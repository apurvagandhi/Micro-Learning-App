# *args   = allows you to pass multiple non-key arguments 
# *kwargs = allows you to pass multiple keyword-arguments 
#           * unpacking operator 
#           1. positional 2. default 3. keyword 4. ARBITRARY

# * ARGS (use one unpacking argument to utilize this tool)
# to use this tool, you don't have to use args, you can use nums or something as long as its preceeded 
# by one unpacking operator 

def add(*args):  # *args allow you to add a variable number of arguments 
    total = 0
    for arg in args: # for each argument 
        total += arg  # adding each argument to the total 
    return total 

print(add(1, 2, 3,))

def display_name(*args):
    for arg in args: 
        print(arg, end=" ")
    print()

display_name("Jaida", "Nicole", "Dorsey")

# ** KWARGS (use two unpacking arguments to utilize this tool)

def print_address(**kwargs):
    for key, value in kwargs.items():
        print(f"{key}: {value}")

print_address(street= "123 Fake St.", 
              city= "Raleigh", 
              state="NC", 
              zip="27607")

# Shipping Label Excercise:

def shipping_label(*args, **kwargs):
    for arg in args:
        print(arg, end=" ")
    print()
    for value in kwargs.values():
        print(value)    

shipping_label("Dr.", "Jaida", "Dorsey", 
               street = "123 Fake St."
               ,city="Wilmington"
               , state="NC")
