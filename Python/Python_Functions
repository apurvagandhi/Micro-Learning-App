# return = statement used to end a function 
#          and send a result back to the caller 

def add(x, y):
    z = x + y
    return z 

def subtract(x, y):
    z = x - y 
    return z 

print(add(1, 2))

def create_name(first, last):
    first = first.capitalize()
    last = last.capitalize()
    return first + " " + last  # this concatenates the strings together with one space in between 
full_name = create_name("jaida", "dorsey")

print(full_name)