# Conditional Expression = A one-line shortcut for the if-else statement (ternary operator)
#                          Print or assign one of two values based on a condition
#                          Return X if condition else Return Y 

num = -8    # assign a number 
num2 = 6
a = 6
b = 7 
age = 18

print("Positive" if num > 0 else "Negative")
result = "EVEN" if num2 %2 ==0 else "ODD"   # if num2 is divisible by 2 "EVEN" if not "ODD"
print(result)

max_num = a if a > b else b # return a if a is greater than b, if not return b 
status = "Adult" if age >= 18 else "Child"
print(status)
