print(" **** Let's Play Rock Paper Scissors! **** ")



while True: 
    play = input("Enter your choice (rock, paper, scissors, or q to quit): ").lower()

    if play == "q":
        break 
    
    if play not in options:
        print("You did not enter a valid option...")
        continue
    
    option = random.choice(options)
    print(f"You chose to play {play}")
    print(f"Your opponent chose to play {option}")
    if play == option:
        print("You tied!")
    elif play == "rock" and option == "scissors":
        print("You won!")
    elif play == "paper" and option == "rock":
        print("You won!")
    elif play == "scissors" and option == "paper":
        print("You won!")
    else:
        print("You lost.....")
      



