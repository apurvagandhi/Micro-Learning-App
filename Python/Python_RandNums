# Creating a tuple of options:
options = ("rock", "paper", "scissors")

# To generate a random whole integer 
# number = random.randint(1, 6) # This would produce a random integer between 1-6 (EX rolling a dice)

# print(number) 

# If you need a random floating point number between 1 and 2 use:
